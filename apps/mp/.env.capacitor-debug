# Native debug build environment. Loaded by `vite build --mode capacitor-debug`
# (see the build:native-debug script in apps/mp/package.json).
#
# This file is committed on purpose and contains no secrets: it only points the native
# debug bundle at the developer machine's API. .gitignore allows this one .env file
# through with an explicit exception.
#
# The address is 127.0.0.1, not 10.0.2.2, because the debug workflow uses
# `adb reverse tcp:3000 tcp:3000`, which works for both the emulator and a physical
# device over USB. 10.0.2.2 is the emulator-only fallback and is intentionally not
# baked into the bundle.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_GOODNIGHT_NATIVE_BUILD=debug
