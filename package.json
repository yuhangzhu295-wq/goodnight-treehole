{
  "name": "goodnight-treehole",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -k -n api,mp,admin \"pnpm dev:api\" \"pnpm dev:h5\" \"pnpm dev:admin\"",
    "dev:mp": "pnpm --filter @goodnight/mp dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "dev:h5": "pnpm --filter @goodnight/mp dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "dev:admin": "pnpm --filter @goodnight/admin dev -- --host 127.0.0.1 --port 5174 --strictPort",
    "dev:api": "pnpm --filter @goodnight/api dev",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-json": "tsx scripts/import-json-store-to-db.ts",
    "db:migrate-runtime-state": "tsx scripts/migrate-runtime-state-to-relational.ts",
    "test": "pnpm qa:all",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:e2e": "vitest run tests/e2e",
    "test:visual": "pnpm test:visual-capture && vitest run tests/visual/front-layout.spec.ts tests/visual/admin-layout.spec.ts",
    "test:visual-capture": "pnpm visual:capture-front && pnpm visual:compare-front",
    "diagnose:runtime": "tsx scripts/diagnose/diagnose-runtime.ts",
    "diagnose:dom-overlays": "tsx scripts/diagnose/diagnose-dom-overlays.ts",
    "diagnose:routes": "tsx scripts/diagnose/diagnose-routes.ts",
    "diagnose:api-bindings": "tsx scripts/diagnose/diagnose-api-bindings.ts",
    "diagnose:clickability": "tsx scripts/diagnose/diagnose-clickability.ts && vitest run tests/diagnose/clickability.spec.ts",
    "diagnose:overflow": "tsx scripts/diagnose/front-horizontal-overflow.ts && vitest run tests/diagnose/overflow.spec.ts",
    "audit:front-navigation-layout": "tsx scripts/audit-front-navigation-layout.ts",
    "test:problem01-layout": "tsx scripts/problem01-layout-click-report.ts",
    "test:problem02-ai": "tsx scripts/problem02-ai-dynamic-report.ts",
    "test:business-flow-01-02": "tsx scripts/business-flow-01-02.ts",
    "qa:problem01-02": "pnpm lint && pnpm typecheck && pnpm test:problem01-layout && pnpm test:problem02-ai && pnpm test:business-flow-01-02",
    "diagnose:all": "tsx scripts/diagnose/diagnose-all.ts",
    "diagnose:first5": "tsx scripts/diagnose/diagnose-first5.ts",
    "diagnose:front-rest": "tsx scripts/diagnose/diagnose-front-rest.ts",
    "audit:ui-artifacts": "tsx scripts/audit-visible-test-artifacts.ts",
    "test:real-browser-front": "tsx scripts/real-browser-front-clicks.ts",
    "test:real-browser-admin": "tsx scripts/real-browser-admin-clicks.ts",
    "test:real-browser-cross": "tsx scripts/real-browser-cross-flow.ts",
    "test:real-browser-front-clicks": "tsx scripts/real-browser-front-clicks.ts",
    "test:real-browser-admin-clicks": "tsx scripts/real-browser-admin-clicks.ts",
    "test:real-browser-cross-flow": "tsx scripts/real-browser-cross-flow.ts",
    "test:admin-sync-full": "tsx scripts/admin-sync-full-report.ts",
    "test:admin-phase3-phase4-real": "tsx scripts/admin-phase3-phase4-real.ts",
    "test:final-live-admin-crud": "tsx scripts/final-live-admin-crud.ts",
    "test:final-human-reply-mute": "tsx scripts/final-human-reply-mute-flow.ts",
    "test:dapi-live": "tsx scripts/dapi-live-audit.ts",
    "test:front-first5-real-user": "tsx scripts/front-first5-real-user.ts",
    "test:front-first5-business-flow": "tsx scripts/front-first5-business-flow.ts",
    "test:front-phase2-tools": "tsx scripts/front-phase2-tools.ts",
    "test:front-phase3-me": "tsx scripts/front-phase3-me.ts",
    "test:front-rest-cross-flow": "tsx scripts/front-rest-cross-flow.ts",
    "test:click-all": "tsx scripts/test-click-all.ts",
    "test:business-flow": "tsx scripts/test-business-flow.ts",
    "test:front-business": "pnpm test:real-browser-front && vitest run tests/business/front-publish-public.spec.ts tests/business/front-publish-private.spec.ts tests/business/front-square-interaction.spec.ts tests/business/front-letter.spec.ts tests/business/front-tools.spec.ts tests/business/front-me.spec.ts",
    "test:admin-sync": "pnpm test:real-browser-cross && vitest run tests/business/admin-sync.spec.ts",
    "test:ai-routing": "vitest run tests/business/ai-provider-routing.spec.ts",
    "test:cross": "vitest run tests/cross",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && vue-tsc -p apps/admin/tsconfig.json --noEmit && vue-tsc -p apps/mp/tsconfig.json --noEmit && tsc --noEmit -p packages/shared-types/tsconfig.json && tsc --noEmit -p packages/api-sdk/tsconfig.json",
    "qa:all": "tsx scripts/qa-all.ts",
    "qa:real-all": "pnpm lint && pnpm typecheck && pnpm diagnose:api-bindings && pnpm diagnose:clickability && pnpm diagnose:overflow && pnpm test:front-business && pnpm test:admin-sync && pnpm test:ai-routing && pnpm test:visual",
    "qa:first5": "tsx scripts/qa-first5.ts",
    "qa:front-rest": "tsx scripts/qa-front-rest.ts",
    "diagnose:front-layout": "tsx scripts/diagnose/front-layout-overlap.ts && tsx scripts/diagnose/front-horizontal-overflow.ts && tsx scripts/diagnose/front-card-spacing.ts && tsx scripts/diagnose/front-safe-area.ts",
    "visual:front-layout": "tsx scripts/diagnose/front-visual-regression.ts",
    "qa:front-layout": "pnpm lint && pnpm typecheck && pnpm diagnose:front-layout && pnpm qa:first5 && pnpm qa:front-rest && pnpm visual:front-layout",
    "visual:extract-assets": "tsx scripts/visual/extract-design-assets.ts",
    "audit:design-references": "tsx scripts/audit-design-references.ts",
    "visual:capture-front": "tsx scripts/visual/capture-front-pages.ts",
    "visual:compare-front": "tsx scripts/visual/compare-front-designs.ts",
    "visual:capture-admin": "tsx scripts/visual/capture-admin-pages.ts",
    "visual:compare-admin": "tsx scripts/visual/compare-admin-designs.ts",
    "visual:front-audit": "tsx scripts/visual/capture-front-pages.ts --phase before && tsx scripts/visual/compare-front-designs.ts --phase before",
    "visual:pixel-front": "tsx scripts/visual/compare-front-designs.ts",
    "visual:pixel-front:page": "tsx scripts/visual/compare-front-designs.ts --page",
    "qa:visual-front": "tsx scripts/visual/qa-visual-front.ts",
    "visual:fixture:bootstrap": "tsx scripts/visual-fixture.ts bootstrap",
    "visual:fixture:reset": "tsx scripts/visual-fixture.ts reset",
    "visual:fixture:start": "tsx scripts/visual-fixture.ts start",
    "visual:fixture:stop": "tsx scripts/visual-fixture.ts stop",
    "visual:fixture:status": "tsx scripts/visual-fixture.ts status",
    "visual:fixture:verify": "tsx scripts/visual-fixture.ts verify",
    "visual:fixture:run": "tsx scripts/visual-fixture-run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@nestjs/testing": "^10.4.20",
    "@prisma/client": "5.22.0",
    "@types/node": "^20.19.4",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.1",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.4.2",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.53.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "sass-embedded": "^1.100.0",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^5.4.19",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.10"
  }
}
