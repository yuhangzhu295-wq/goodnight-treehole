# Dependencies and local runtimes
node_modules/
.venv*/

# Local configuration and secrets
.env
.env.*
!.env.example
# The native debug build needs its API base URL at bundle time, and the value is a
# developer-machine address rather than a secret. Without this exception
# `pnpm --filter @goodnight/mp build:native-debug` would silently produce a bundle
# with no API URL. Never put a credential in this file.
!apps/mp/.env.capacitor-debug
*.pem
*.key

# Runtime state, databases, and generated delivery artifacts
data/
artifacts/
outputs/
reports/
work/
coverage/
dist/
.vite/

# Logs and editor/OS state
*.log
*.pid
.DS_Store
Thumbs.db
.idea/
.vscode/
